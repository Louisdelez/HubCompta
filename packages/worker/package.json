{
  "name": "@finance-hub/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@finance-hub/shared": "workspace:*",
    "@prisma/client": "^5.9.0",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.0",
    "minio": "^7.1.0",
    "pino": "^8.18.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0"
  }
}
