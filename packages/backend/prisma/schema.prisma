// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String           @db.Text
  data        Json? // Additional data (e.g., entity references)
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([workspaceId])
  @@index([type])
  @@map("notifications")
}

enum NotificationType {
  budget_alert // Budget exceeded or near limit
  budget_warning // Budget approaching limit
  bill_reminder // Upcoming bill/recurring transaction
  import_complete // Import job completed
  export_ready // Export file ready
  invoice_overdue // Invoice payment overdue
  invoice_paid // Invoice marked as paid
  quote_accepted // Quote accepted by client
  quote_expiring // Quote about to expire
  price_alert // Investment price alert
  system // System notification
  // Smart notifications
  savings_milestone // 25%, 50%, 75%, 100% reached
  savings_off_track // Behind on savings goal
  unusual_spending // Anomaly detected
  weekly_summary // Weekly spending summary
  monthly_report // Monthly financial report
  low_balance_warning // Account balance below threshold
  recurring_processed // Recurring transaction processed
  goal_achieved // Savings goal completed
}

model AlertRule {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  workspaceId     String?       @map("workspace_id") @db.Uuid
  type            AlertRuleType
  name            String        @db.VarChar(100)
  isEnabled       Boolean       @default(true) @map("is_enabled")
  config          Json // Rule-specific configuration
  lastTriggeredAt DateTime?     @map("last_triggered_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([type, isEnabled])
  @@map("alert_rules")
}

enum AlertRuleType {
  budget_threshold // Alert when budget reaches X%
  price_above // Alert when asset price goes above X
  price_below // Alert when asset price goes below X
  price_change // Alert on X% price change
  low_balance // Alert when account balance below X
  large_transaction // Alert on transactions above X
  recurring_reminder // Reminder before recurring transaction
}

