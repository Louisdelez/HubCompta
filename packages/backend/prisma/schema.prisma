  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([savingsGoalId])
  @@index([savingsGoalId, date])
  @@map("savings_contributions")
}

// ============================================================================
// AI CATEGORIZATION
// ============================================================================

model CategoryPrediction {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id") @db.Uuid
  transactionId       String   @map("transaction_id") @db.Uuid
  suggestedCategoryId String   @map("suggested_category_id") @db.Uuid
  confidence          Decimal  @db.Decimal(3, 2) // 0.00 to 1.00
  features            Json     // { merchant, amount, dayOfWeek, etc }
  accepted            Boolean? // null = pending, true = accepted, false = rejected
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [suggestedCategoryId], references: [id], onDelete: Cascade)

  @@unique([transactionId])
  @@index([workspaceId])
  @@index([suggestedCategoryId])
  @@map("category_predictions")
}

// ============================================================================
// BANK SYNCHRONIZATION (Open Banking)
// ============================================================================

model BankConnection {
  id                   String               @id @default(cuid())
  workspaceId          String               @map("workspace_id") @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  provider             BankProvider
  providerConnectionId String               @map("provider_connection_id") @db.VarChar(255)
  institutionId        String               @map("institution_id") @db.VarChar(100)
  institutionName      String               @map("institution_name") @db.VarChar(200)
  institutionLogo      String?              @map("institution_logo") @db.Text
  status               BankConnectionStatus @default(active)
  lastSyncAt           DateTime?            @map("last_sync_at")
  lastSyncError        String?              @map("last_sync_error") @db.Text
  consentExpiresAt     DateTime?            @map("consent_expires_at")
  accessToken          String?              @map("access_token") @db.Text // Encrypted
  refreshToken         String?              @map("refresh_token") @db.Text // Encrypted
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[]

  @@unique([workspaceId, providerConnectionId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@map("bank_connections")
}

model BankAccount {
  id                String   @id @default(cuid())
  connectionId      String   @map("connection_id")
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  linkedAccountId   String?  @map("linked_account_id") @db.Uuid
  name              String   @db.VarChar(200)
  iban              String?  @db.VarChar(34)
  balance           Decimal  @db.Decimal(19, 4)
  availableBalance  Decimal? @map("available_balance") @db.Decimal(19, 4)
  currency          String   @db.VarChar(3)
  type              String   @db.VarChar(50) // checking, savings, credit_card, etc
  lastSyncAt        DateTime? @map("last_sync_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  connection    BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  linkedAccount Account?       @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerAccountId])
  @@index([connectionId])
  @@index([linkedAccountId])
  @@map("bank_accounts")
}

enum BankProvider {
  nordigen // GoCardless (free for EU)
  tink // Alternative EU provider
  plaid // USA/Canada
  truelayer // UK/EU
}

enum BankConnectionStatus {
  active
  expired
  error
  disconnected
  pending_auth
}

// ============================================================================
// GAMIFICATION
// ============================================================================

model Achievement {
  id          String @id @default(cuid())
  code        String @unique @db.VarChar(50)
  name        String @db.VarChar(100)
  description String @db.Text
  icon        String @db.VarChar(10)
  category    String @db.VarChar(50) // savings, budgeting, tracking, streaks, milestones
  threshold   Int // Value to reach
  xpReward    Int    @map("xp_reward")
  isSecret    Boolean @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userAchievements UserAchievement[]

  @@index([category])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id")
  progress      Int      @default(0) // Current progress towards threshold
  unlockedAt    DateTime? @map("unlocked_at") // null if not yet unlocked
  notifiedAt    DateTime? @map("notified_at") // When user was notified
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model UserStats {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id") @db.Uuid
  totalXp          Int      @default(0) @map("total_xp")
  level            Int      @default(1)
  currentStreak    Int      @default(0) @map("current_streak")
  longestStreak    Int      @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  transactionCount Int      @default(0) @map("transaction_count")
  budgetsOnTrack   Int      @default(0) @map("budgets_on_track")
  goalsCompleted   Int      @default(0) @map("goals_completed")
  totalSaved       Decimal  @default(0) @map("total_saved") @db.Decimal(19, 4)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ============================================================================
// DASHBOARD LAYOUTS
// ============================================================================

model DashboardLayout {
  id          String     @id @default(cuid())
  userId      String     @map("user_id") @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  widgets     Json       // Array of { id, type, position: {x, y, w, h}, config: {} }
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("dashboard_layouts")
}
