// ============================================================================
// PRISMA SCHEMA - Finance Hub
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(255)
  displayName     String   @map("display_name") @db.VarChar(100)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  locale          String   @default("fr-FR") @db.VarChar(10)
  timezone        String   @default("Europe/Paris") @db.VarChar(50)
  theme           String   @default("system") @db.VarChar(20) // light, dark, system
  preferences     Json     @default("{}") // User preferences JSON
  isInstanceAdmin Boolean  @default(false) @map("is_instance_admin")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  mfaMethods              MFA[]
  devices                 Device[]
  sessions                Session[]
  memberships             Membership[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  uploadedDocuments       Document[]
  importJobs              ImportJob[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  alertRules              AlertRule[]
  savedFilters            SavedFilter[]
  searchHistory           SearchHistory[]
  reportTemplates         ReportTemplate[]
  notificationPreferences NotificationPreferences?
  dashboardLayouts        DashboardLayout[]
  bankConnections         BankConnection[]
  userAchievements        UserAchievement[]
  userStats               UserStats?

  @@map("users")
}

model MFA {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      MFAType
  name      String    @db.VarChar(100)
  secret    String    @db.Text // Encrypted TOTP secret or WebAuthn credential
  isEnabled Boolean   @default(true) @map("is_enabled")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_methods")
}

enum MFAType {
  totp
  webauthn
}

model Device {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fingerprint String   @db.VarChar(255)
  name        String   @db.VarChar(100)
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  isTrusted   Boolean  @default(false) @map("is_trusted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("devices")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  isLocked  Boolean   @default(false) @map("is_locked")
  lockedAt  DateTime? @map("locked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model NotificationPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id") @db.Uuid
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  budgetAlerts     Boolean  @default(true) @map("budget_alerts")
  invoiceReminders Boolean  @default(true) @map("invoice_reminders")
  weeklySummary    Boolean  @default(false) @map("weekly_summary")
  marketingEmails  Boolean  @default(false) @map("marketing_emails")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================================================
// WORKSPACE & MEMBERSHIP
// ============================================================================

model Workspace {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(100)
  type      WorkspaceType
  currency  String        @default("EUR") @db.VarChar(3)
  ownerId   String        @map("owner_id") @db.Uuid
  settings  Json          @default("{}")
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  owner                 User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships           Membership[]
  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  tags                  Tag[]
  budgets               Budget[]
  documents             Document[]
  rules                 Rule[]
  recurrences           Recurrence[]
  importJobs            ImportJob[]
  contacts              Contact[]
  quotes                Quote[]
  invoices              Invoice[]
  positions             Position[]
  watchlists            Watchlist[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  alertRules            AlertRule[]
  savedFilters          SavedFilter[]
  portfolioSnapshots    PortfolioSnapshot[]
  searchHistory         SearchHistory[]
  searchTerms           SearchTerm[]
  reportTemplates       ReportTemplate[]
  priceAlerts           PriceAlert[]
  loans                 Loan[]
  scheduledTransactions ScheduledTransaction[]
  netWorthSnapshots     NetWorthSnapshot[]
  bills                 Bill[]
  budgetForecasts       BudgetForecast[]
  savingsGoals          SavingsGoal[]
  taxYears              TaxYear[]
  dashboardLayouts      DashboardLayout[]
  categoryPatterns      CategoryPattern[]
  bankConnections       BankConnection[]
  categoryPredictions   CategoryPrediction[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

enum WorkspaceType {
  personal
  family
  flatshare
  company
}

model Membership {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  role              MembershipRole
  // Family sharing fields
  spendingLimit     Decimal?       @map("spending_limit") @db.Decimal(19, 4)
  approvalRequired  Boolean        @default(false) @map("approval_required")
  visibleCategories String[]       @map("visible_categories")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

enum MembershipRole {
  owner
  admin
  accountant
  member
  readonly
}

// ============================================================================
// ACCOUNTS & TRANSACTIONS
// ============================================================================

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String      @db.VarChar(100)
  type        AccountType
  currency    String      @default("EUR") @db.VarChar(3)
  balance     Decimal     @default(0) @db.Decimal(19, 4)
  icon        String?     @db.VarChar(10)
  color       String?     @db.VarChar(7) // Hex color
  isArchived  Boolean     @default(false) @map("is_archived")
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  importJobs            ImportJob[]
  positions             Position[]
  scheduledTransactions ScheduledTransaction[]
  savingsGoals          SavingsGoal[]
  linkedBankAccounts    BankAccount[]

  @@index([workspaceId])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, deletedAt])
  @@map("accounts")
}

enum AccountType {
  checking
  savings
  credit_card
  cash
  investment
  loan
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @map("workspace_id") @db.Uuid
  accountId      String            @map("account_id") @db.Uuid
  type           TransactionType
  amount         Decimal           @db.Decimal(19, 4)
  currency       String            @default("EUR") @db.VarChar(3)
  date           DateTime          @db.Date
  description    String            @db.VarChar(500)
  notes          String?           @db.Text
  categoryId     String?           @map("category_id") @db.Uuid
  status         TransactionStatus @default(pending)
  isRecurring    Boolean           @default(false) @map("is_recurring")
  isReconciled   Boolean           @default(false) @map("is_reconciled")
  recurrenceId   String?           @map("recurrence_id") @db.Uuid
  importHash     String?           @map("import_hash") @db.VarChar(64)
  transferPairId String?           @unique @map("transfer_pair_id") @db.Uuid
  appliedRuleId  String?           @map("applied_rule_id") @db.Uuid
  deletedAt      DateTime?         @map("deleted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurrence            Recurrence?            @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  transferPair          Transaction?           @relation("TransferPair", fields: [transferPairId], references: [id])
  pairedTransfer        Transaction?           @relation("TransferPair")
  appliedRule           Rule?                  @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)
  tags                  TransactionTag[]
  documentLinks         DocumentLink[]
  linkedInvoices        Invoice[]
  scheduledTransactions ScheduledTransaction[]
  linkedBills           Bill[]
  categoryPrediction    CategoryPrediction?

  @@unique([workspaceId, importHash])
  @@index([workspaceId, date])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
  @@index([accountId, date])
  @@index([appliedRuleId])
  @@index([deletedAt])
  @@index([workspaceId, deletedAt])
  @@map("transactions")
}

enum TransactionType {
  expense
  income
  transfer
}

enum TransactionStatus {
  pending
  cleared
  reconciled
}

model TransactionTag {
  transactionId String @map("transaction_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

// ============================================================================
// CATEGORIES & TAGS
// ============================================================================

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  name        String       @db.VarChar(100)
  type        CategoryType
  icon        String?      @db.VarChar(10)
  color       String?      @db.VarChar(7)
  isSystem    Boolean      @default(false) @map("is_system")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent                Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Category[]             @relation("CategoryHierarchy")
  transactions          Transaction[]
  budgets               Budget[]
  scheduledTransactions ScheduledTransaction[]
  budgetForecasts       BudgetForecast[]
  bills                 Bill[]
  patterns              CategoryPattern[]
  predictions           CategoryPrediction[]

  @@unique([workspaceId, name, type])
  @@index([workspaceId, type])
  @@index([parentId])
  @@map("categories")
}

enum CategoryType {
  expense
  income
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(50)
  color       String?  @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

// ============================================================================
// BUDGETS
// ============================================================================

model Budget {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  categoryId      String       @map("category_id") @db.Uuid
  name            String       @db.VarChar(100)
  amount          Decimal      @db.Decimal(19, 4)
  period          BudgetPeriod
  alertThreshold  Int          @default(80) @map("alert_threshold")
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  // Envelope mode fields
  envelopeMode    Boolean      @default(false) @map("envelope_mode")
  rolloverEnabled Boolean      @default(true) @map("rollover_enabled")
  rolloverAmount  Decimal      @default(0) @map("rollover_amount") @db.Decimal(19, 4)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, categoryId])
  @@map("budgets")
}

enum BudgetPeriod {
  monthly
  yearly
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  uploaderId   String         @map("uploader_id") @db.Uuid
  filename     String         @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  size         Int            @db.Integer
  storageKey   String         @map("storage_key") @db.VarChar(255)
  hash         String         @db.VarChar(64) // SHA-256
  status       DocumentStatus @default(inbox)
  isVault      Boolean        @default(false) @map("is_vault")
  encryptedKey String?        @map("encrypted_key") @db.Text // For E2EE vault docs
  content      String?        @db.Text // OCR extracted text content for search
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader      User           @relation(fields: [uploaderId], references: [id])
  links         DocumentLink[]
  taxDeductions TaxDeduction[]

  // Note: search_vector column managed by PostgreSQL trigger (not in Prisma)

  @@unique([workspaceId, hash])
  @@index([workspaceId, status])
  @@index([deletedAt])
  @@index([workspaceId, deletedAt])
  @@index([uploaderId])
  @@map("documents")
}

enum DocumentStatus {
  inbox
  linked
  archived
}

model DocumentLink {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([documentId, transactionId])
  @@index([transactionId])
  @@index([documentId])
  @@map("document_links")
}

// ============================================================================
// RULES & AUTOMATION
// ============================================================================

model Rule {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(100)
  priority    Int      @default(0)
  conditions  Json // Array of RuleCondition
  actions     Json // Array of RuleAction
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appliedTransactions Transaction[]

  @@index([workspaceId, isEnabled])
  @@map("rules")
}

model CategoryPattern {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id") @db.Uuid
  pattern     String   @db.VarChar(500) // merchant/description pattern
  categoryId  String   @map("category_id") @db.Uuid
  confidence  Decimal  @db.Decimal(3, 2) // 0.00 to 1.00
  matchCount  Int      @default(0) @map("match_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pattern])
  @@index([workspaceId])
  @@index([pattern])
  @@index([categoryId])
  @@map("category_patterns")
}

model Recurrence {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  name        String         @db.VarChar(100)
  frequency   RecurrenceFreq
  interval    Int            @default(1)
  dayOfMonth  Int?           @map("day_of_month")
  dayOfWeek   Int?           @map("day_of_week")
  template    Json // Transaction template
  nextRunAt   DateTime       @map("next_run_at")
  endAt       DateTime?      @map("end_at")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, isActive])
  @@index([nextRunAt, isActive])
  @@map("recurrences")
}

enum RecurrenceFreq {
  daily
  weekly
  monthly
  yearly
}

// ============================================================================
// IMPORT
// ============================================================================

model ImportJob {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  accountId     String       @map("account_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  fileName      String       @map("file_name") @db.VarChar(255)
  fileContent   String       @map("file_content") @db.Text
  status        ImportStatus @default(pending)
  totalRows     Int          @default(0) @map("total_rows")
  processedRows Int          @default(0) @map("processed_rows")
  importedRows  Int          @default(0) @map("imported_rows")
  skippedRows   Int          @default(0) @map("skipped_rows")
  errorRows     Int          @default(0) @map("error_rows")
  error         String?      @db.Text
  columnMapping Json         @default("{}") @map("column_mapping")
  errors        Json         @default("[]")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  completedAt   DateTime?    @map("completed_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([status])
  @@index([accountId])
  @@index([userId])
  @@map("import_jobs")
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}

// ============================================================================
// PRO MODE - INVOICING
// ============================================================================

model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  type        ContactType
  name        String      @db.VarChar(200)
  email       String?     @db.VarChar(255)
  phone       String?     @db.VarChar(20)
  address     String?     @db.Text
  company     String?     @db.VarChar(200) // Company name for search
  siret       String?     @db.VarChar(14)
  vatNumber   String?     @map("vat_number") @db.VarChar(20)
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes    Quote[]
  invoices  Invoice[]

  // Note: search_vector column managed by PostgreSQL trigger (not in Prisma)

  @@index([workspaceId, type])
  @@index([deletedAt])
  @@map("contacts")
}

enum ContactType {
  client
  supplier
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  contactId   String      @map("contact_id") @db.Uuid
  number      String      @db.VarChar(50)
  status      QuoteStatus @default(draft)
  issueDate   DateTime    @map("issue_date") @db.Date
  validUntil  DateTime    @map("valid_until") @db.Date
  subtotal    Decimal     @db.Decimal(19, 4)
  vatAmount   Decimal     @map("vat_amount") @db.Decimal(19, 4)
  total       Decimal     @db.Decimal(19, 4)
  notes       String?     @db.Text
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id])
  lines     InvoiceLine[]
  invoices  Invoice[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([deletedAt])
  @@index([contactId])
  @@map("quotes")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  workspaceId         String        @map("workspace_id") @db.Uuid
  contactId           String        @map("contact_id") @db.Uuid
  quoteId             String?       @map("quote_id") @db.Uuid
  number              String        @db.VarChar(50)
  status              InvoiceStatus @default(draft)
  issueDate           DateTime      @map("issue_date") @db.Date
  dueDate             DateTime      @map("due_date") @db.Date
  subtotal            Decimal       @db.Decimal(19, 4)
  vatAmount           Decimal       @map("vat_amount") @db.Decimal(19, 4)
  total               Decimal       @db.Decimal(19, 4)
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(19, 4)
  paidAt              DateTime?     @map("paid_at")
  notes               String?       @db.Text
  linkedTransactionId String?       @map("linked_transaction_id") @db.Uuid
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact           Contact       @relation(fields: [contactId], references: [id])
  quote             Quote?        @relation(fields: [quoteId], references: [id])
  linkedTransaction Transaction?  @relation(fields: [linkedTransactionId], references: [id])
  lines             InvoiceLine[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([deletedAt])
  @@index([contactId])
  @@index([quoteId])
  @@index([linkedTransactionId])
  @@map("invoices")
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

model InvoiceLine {
