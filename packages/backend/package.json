{
  "name": "@finance-hub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@finance-hub/shared": "workspace:*",
    "@prisma/client": "^5.9.0",
    "@simplewebauthn/server": "^9.0.0",
    "argon2": "^0.31.0",
    "bullmq": "^5.1.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^3.3.0",
    "fast-jwt": "^6.1.0",
    "fastify": "^4.25.0",
    "ioredis": "^5.3.0",
    "libsodium-wrappers": "^0.7.13",
    "minio": "^7.1.0",
    "otpauth": "^9.2.0",
    "papaparse": "^5.5.3",
    "pino": "^8.18.0",
    "uuid": "^9.0.0",
    "yahoo-finance2": "^3.13.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/uuid": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.9.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0"
  }
}
