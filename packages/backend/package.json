{
  "name": "@finance-hub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@finance-hub/shared": "workspace:*",
    "@prisma/client": "^5.9.0",
    "@sentry/node": "^10.38.0",
    "@simplewebauthn/server": "^9.0.0",
    "argon2": "^0.31.0",
    "bullmq": "^5.1.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^3.3.0",
    "fast-jwt": "^6.1.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.3.0",
    "minio": "^7.1.0",
    "otpauth": "^9.2.0",
    "papaparse": "^5.5.3",
    "uuid": "^9.0.0",
    "yahoo-finance2": "^3.13.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "prisma": "^5.9.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0"
  }
}
