# ============================================================================
# Finance Hub - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values
# For production, also copy to .env.local

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3001
FRONTEND_PORT=3000
LOG_LEVEL=info

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your actual domain(s)
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=finance_hub
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379"

# ----------------------------------------------------------------------------
# Security (Generate with: openssl rand -base64 32)
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_32_chars

# ----------------------------------------------------------------------------
# MFA
# ----------------------------------------------------------------------------
MFA_ISSUER=Finance Hub
SESSION_LOCK_MINUTES=10
SESSION_EXPIRY_HOURS=24

# ----------------------------------------------------------------------------
# Object Storage (MinIO/S3)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# Monitoring (Sentry)
# ----------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Development Only
# ----------------------------------------------------------------------------
# Uncomment for development with default credentials:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_hub"
# REDIS_URL="redis://localhost:6379"
