# ============================================================================
# Finance Hub - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values
# For production, also copy to .env.local

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3001
FRONTEND_PORT=3000
LOG_LEVEL=info

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your actual domain(s)
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=finance_hub
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379"

# ----------------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------------
# Set to 'false' to disable Redis caching (app will work without it)
REDIS_ENABLED=true

# Default cache TTL in seconds (5 minutes)
CACHE_TTL_DEFAULT=300

# ----------------------------------------------------------------------------
# Security (Generate with: openssl rand -base64 32)
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_32_chars

# ----------------------------------------------------------------------------
# MFA
# ----------------------------------------------------------------------------
MFA_ISSUER=Finance Hub
SESSION_LOCK_MINUTES=10
SESSION_EXPIRY_HOURS=24

# ----------------------------------------------------------------------------
# Object Storage (MinIO/S3)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# Monitoring (Sentry)
# ----------------------------------------------------------------------------
# Get your DSN from sentry.io project settings
SENTRY_DSN=
VITE_SENTRY_DSN=

# Set to 'false' to disable Sentry even when DSN is configured
SENTRY_ENABLED=true
VITE_SENTRY_ENABLED=true

# Optional: App version for release tracking
VITE_APP_VERSION=1.0.0

# ----------------------------------------------------------------------------
# Push Notifications (Web Push / VAPID)
# ----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Public key is safe to expose to clients
VAPID_PUBLIC_KEY=
# Private key must be kept secret
VAPID_PRIVATE_KEY=
# Contact email for push service (required by web-push)
VAPID_EMAIL=mailto:admin@hubcompta.com

# ----------------------------------------------------------------------------
# Email (SMTP)
# ----------------------------------------------------------------------------
# Configure one of the following email providers:

# Generic SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hubcompta.com
SMTP_FROM_NAME=HubCompta

# Or use SendGrid
# SENDGRID_API_KEY=

# Or use AWS SES (requires AWS credentials)
# AWS_SES_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# WhatsApp (Twilio)
# ----------------------------------------------------------------------------
# Sign up at twilio.com for WhatsApp Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# ----------------------------------------------------------------------------
# SMS (Twilio)
# ----------------------------------------------------------------------------
TWILIO_SMS_NUMBER=

# ----------------------------------------------------------------------------
# OCR (Tesseract)
# ----------------------------------------------------------------------------
# Path to Tesseract binary (optional, auto-detected if not set)
TESSERACT_PATH=

# ----------------------------------------------------------------------------
# AI Services (Optional)
# ----------------------------------------------------------------------------
# OpenAI for transaction categorization
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Banking Integration (Optional)
# ----------------------------------------------------------------------------
# Nordigen/GoCardless for Open Banking
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

# ----------------------------------------------------------------------------
# Development Only
# ----------------------------------------------------------------------------
# Uncomment for development with default credentials:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_hub"
# REDIS_URL="redis://localhost:6379"
