# ============================================================================
# ENVIRONMENT VARIABLES - Finance Hub Production
# Copy this file to .env and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------

# Your domain (required for HTTPS/Traefik)
DOMAIN=hubcompta.example.com

# Application name
APP_NAME=Finance Hub

# Timezone
TZ=Europe/Paris

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# PostgreSQL credentials
DB_USER=hubcompta
DB_PASSWORD=your_secure_database_password_here
DB_NAME=hubcompta

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------

# Redis password
REDIS_PASSWORD=your_secure_redis_password_here

# ----------------------------------------------------------------------------
# JWT Secrets
# ----------------------------------------------------------------------------

# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_at_least_32_characters

# ----------------------------------------------------------------------------
# Object Storage (MinIO)
# ----------------------------------------------------------------------------

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_minio_password_here
S3_BUCKET=hubcompta

# ----------------------------------------------------------------------------
# SSL/TLS (Let's Encrypt)
# ----------------------------------------------------------------------------

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# ----------------------------------------------------------------------------
# Backup
# ----------------------------------------------------------------------------

# Number of days to keep backups
BACKUP_RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# Optional: External Services
# ----------------------------------------------------------------------------

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# SMTP for email notifications (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@example.com

# Push notifications (optional)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
